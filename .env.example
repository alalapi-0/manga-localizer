# Copy to .env for local development. Never commit .env.
MANGA_LOCALIZER_HOST=127.0.0.1
MANGA_LOCALIZER_PORT=8000
MANGA_LOCALIZER_WEB_HOST=127.0.0.1
MANGA_LOCALIZER_WEB_PORT=5173
MANGA_LOCALIZER_DATA_DIR=.manga-localizer
MANGA_LOCALIZER_LOG_LEVEL=INFO

# OCR executable and languages. Install Tesseract separately on your operating system.
MANGA_LOCALIZER_TESSERACT_COMMAND=tesseract
MANGA_LOCALIZER_OCR_LANGUAGES=jpn,jpn_vert

# Optional remote translation. The key is read from the process environment only.
MANGA_LOCALIZER_OPENAI_BASE_URL=https://api.openai.com/v1
MANGA_LOCALIZER_OPENAI_MODEL=gpt-4.1-mini
MANGA_LOCALIZER_OPENAI_API_KEY=

# Frontend development proxy target.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
