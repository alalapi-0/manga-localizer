# Copy to .env for local development. Never commit .env.
MANGA_LOCALIZER_HOST=127.0.0.1
MANGA_LOCALIZER_PORT=8000
MANGA_LOCALIZER_WEB_HOST=127.0.0.1
MANGA_LOCALIZER_WEB_PORT=5173
MANGA_LOCALIZER_DATA_DIR=.manga-localizer
MANGA_LOCALIZER_LOG_LEVEL=INFO

# OCR executable and languages. Install Tesseract separately on your operating system.
MANGA_LOCALIZER_TESSERACT_COMMAND=tesseract
MANGA_LOCALIZER_OCR_LANGUAGES=jpn,jpn_vert

# Optional local providers. Leave unset to use the standard files below DATA_DIR/models.
# MANGA_LOCALIZER_PPOCR_DETECTION_MODEL=/absolute/path/to/text_detection_cn_ppocrv3_2023may.onnx
# MANGA_LOCALIZER_LAMA_INPAINTING_MODEL=/absolute/path/to/inpainting_lama_2025jan.onnx
# MANGA_LOCALIZER_REALESRGAN_ONNX_MODEL=/absolute/path/to/RealESRGAN_x4plus_anime_6B.onnx
# MANGA_LOCALIZER_REALESRGAN_NCNN_COMMAND=/absolute/path/to/realesrgan-ncnn-vulkan
# MANGA_LOCALIZER_REALESRGAN_NCNN_MODELS=/absolute/path/to/realesrgan-models

# Optional remote translation. The key is read from the process environment only.
MANGA_LOCALIZER_OPENAI_BASE_URL=https://api.openai.com/v1
MANGA_LOCALIZER_OPENAI_MODEL=gpt-4.1-mini
MANGA_LOCALIZER_OPENAI_API_KEY=

# Frontend development proxy target.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Application mode (`npm run app`) serves the built workbench from this folder.
# MANGA_LOCALIZER_FRONTEND_DIST=/absolute/path/to/frontend/dist

# Optional same-LAN iPhone companion. Default remains loopback; prefer `npm run app:lan`.
# MANGA_LOCALIZER_LAN_ACCESS=0
