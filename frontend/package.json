{
  "name": "manga-localizer-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "storage:check": "node ../scripts/external-frontend.mjs --check",
    "predev": "npm run storage:check",
    "dev": "vite",
    "prebuild": "npm run storage:check",
    "build": "tsc -b && vite build",
    "prelint": "npm run storage:check",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "npm run storage:check",
    "typecheck": "tsc -b --pretty false",
    "pretest": "npm run storage:check",
    "test": "vitest run",
    "pretest:watch": "npm run storage:check",
    "test:watch": "vitest"
  },
  "dependencies": {
    "konva": "10.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
